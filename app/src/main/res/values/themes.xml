<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!--
        Splash screen theme, applied only momentarily at process start
        (see MainActivity.onCreate, which calls installSplashScreen()
        before setContent and then switches the activity back to
        Theme.MyApplication). Kept as a single solid brand color plus the
        centered icon mark  no text, no gradient per the platform
        SplashScreen API's own constraints (it only supports a solid
        background color and a single centered icon/animated-icon
        drawable; anything more elaborate has to be its own in-app
        Compose screen, not this system-level theme).

        Uses the .IconBackground variant (rather than plain
        Theme.SplashScreen) because the Folia mark is an irregular
        open-book/leaf silhouette, not a simple round glyph  per
        AndroidX's own guidance, non-round icons need an explicit
        windowSplashScreenIconBackgroundColor so the system's icon
        scaling/masking on Android 12+ matches how a plain
        Theme.SplashScreen icon would otherwise be masked as if round.
        That color is set to the same navy as the splash background
        itself (rather than white, the usual default) so it reads as
        one continuous brand color rather than a visible box behind
        the icon.
    -->
    <style name="Theme.Folia.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
